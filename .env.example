# Copy to .env.local for local dev (run: npx tsx --env-file=.env.local server/index.ts)
NODE_ENV=development
PORT=5050
PUBLIC_URL=http://localhost:5050

# Required
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
SESSION_SECRET=long-random-string

# Email (welcome, password reset, contact form). Without it, reset links are printed in the server log.
RESEND_API_KEY=

# Payments (web)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Data sources. The app still runs without them; the related report sections show less data.
RAPIDAPI_KEY=          # crime by ZIP, listings + this home's Zillow rent/value/tax
GEOAPIFY_API_KEY=     # walkability (free plan: 3,000 credits/day)
AIRNOW_API_KEY=       # air quality, EPA AirNow (free, commercial use OK)
CENSUS_API_KEY=
RENTCAST_API_KEY=
SCHOOLDIGGER_APP_ID=
SCHOOLDIGGER_APP_KEY=
PERPLEXITY_API_KEY=    # written market outlook summary
FRED_API_KEY=
BLS_API_KEY=
HUD_API_KEY=
HUD_TOKEN=
FBI_CRIME_API_KEY=
DATA_GOV_API_KEY=
